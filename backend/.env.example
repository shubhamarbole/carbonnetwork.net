# ==============================================================================
# CARBONCREDIT.NETWORK - BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5050

# MongoDB Database Connection String (Mongoose & Prisma ORM)
DATABASE_URL="mongodb://localhost:27017/esg-environmental"
MONGO_URI="mongodb://localhost:27017/esg-environmental"

# JWT Secret for Session & API Token Signing
JWT_SECRET="environmental-esg-secret-key-98765"

# AI / LLM Integrations (Optional)
GEMINI_API_KEY=""
PYTHON_AI_URL="http://localhost:8000"

# Embedded MQTT Broker Settings
MQTT_PORT=1883
MQTT_HOST="0.0.0.0"

# Node Environment
NODE_ENV="production"
