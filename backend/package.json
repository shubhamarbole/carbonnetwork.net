{
  "name": "esg-environmental-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "Environmental ESG Management Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "nodemon --watch src -e ts,json --exec tsx src/server.ts",
    "seed": "node config/seedData.js",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-mongo": "^8.0.0-rc.8",
    "aedes": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.1",
    "mqtt": "^5.15.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "nodemon": "^3.1.0",
    "prisma": "^8.0.0-rc.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
